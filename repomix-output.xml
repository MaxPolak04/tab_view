<file path="tab_view/templates/admin/logs.html">
{% extends 'layout/base.html' %}

{% block title %}Audit Logs{% endblock %}

{% block content %}
<div class="container py-5">
    <div class="d-flex justify-content-between align-items-center mb-4 flex-wrap gap-3">
        <div>
            <h2 class="fw-bold mb-0">System Audit Logs</h2>
            <p class="text-body-secondary mb-0">Track user actions and system events.</p>
        </div>
    </div>
    <div class="card border-0 shadow-sm rounded-4 bg-body-tertiary mb-4">
        <div class="card-body p-4 p-md-5">
            <form method="GET" action="{{ url_for('logs.view_logs') }}">
                <div class="row g-4">
                    <div class="col-md-6 col-xl-3">
                        <label class="form-label fw-bold">Search Details</label>
                        <div class="input-group input-group-lg shadow-sm rounded-3">
                            <span class="input-group-text bg-body border-end-0"><i class="bi bi-search text-muted"></i></span>
                            <input type="text" name="q" class="form-control border-start-0 ps-0" placeholder="Search logs..." value="{{ search_query }}">
                        </div>
                    </div>
                    <div class="col-md-6 col-xl-3">
                        <label class="form-label fw-bold">Action</label>
                        <select name="action" class="form-select form-select-lg shadow-sm rounded-3">
                            <option value="">All Actions</option>
                            {% for action in unique_actions %}
                                <option value="{{ action }}" {% if current_action == action %}selected{% endif %}>{{ action }}</option>
                            {% endfor %}
                        </select>
                    </div>
                    <div class="col-md-6 col-xl-3">
                        <label class="form-label fw-bold">Entity</label>
                        <select name="entity" class="form-select form-select-lg shadow-sm rounded-3">
                            <option value="">All Entities</option>
                            {% for entity in unique_entities %}
                                <option value="{{ entity }}" {% if current_entity == entity %}selected{% endif %}>{{ entity }}</option>
                            {% endfor %}
                        </select>
                    </div>
                    <div class="col-md-6 col-xl-3">
                        <label class="form-label fw-bold">User</label>
                        <select name="user" class="form-select form-select-lg shadow-sm rounded-3">
                            <option value="">All Users</option>
                            {% for user in all_users %}
                                <option value="{{ user.id }}" {% if current_user_filter == user.id %}selected{% endif %}>{{ user.username }}</option>
                            {% endfor %}
                        </select>
                    </div>
                </div>
                <div class="d-flex justify-content-end align-items-center mt-4 gap-3">
                    <a href="{{ url_for('logs.view_logs') }}" class="btn btn-secondary btn-lg px-5 shadow-sm rounded-pill">
                        <i class="bi bi-x-circle me-1"></i> Clear Filters
                    </a>
                    <button type="submit" class="btn btn-primary btn-lg px-5 shadow-sm rounded-pill">
                        <i class="bi bi-funnel me-1"></i> Apply Filters
                    </button>
                </div>
            </form>
        </div>
    </div>

    <!-- Log table -->
    <div class="card border-0 shadow-sm rounded-4 bg-body-tertiary overflow-hidden">
        <div class="table-responsive">
            <table class="table table-hover align-middle mb-0">
                <thead class="border-bottom">
                    <tr>
                        <th class="ps-4 py-3 text-uppercase small fw-bold text-body-secondary" style="width: 15%;">Timestamp</th>
                        <th class="py-3 text-uppercase small fw-bold text-body-secondary" style="width: 20%;">User</th>
                        <th class="py-3 text-uppercase small fw-bold text-body-secondary" style="width: 20%;">Action / Entity</th>
                        <th class="pe-4 py-3 text-uppercase small fw-bold text-body-secondary" style="width: 45%;">Details</th>
                    </tr>
                </thead>
                <tbody>
                    {% for log in logs %}
                    <tr class="{% if log.action == 'DELETE' %}bg-danger bg-opacity-10{% endif %}">
                        <td class="ps-4 py-3">
                            <div class="fw-medium text-body-emphasis">{{ log.timestamp.strftime('%Y-%m-%d') }}</div>
                            <div class="small text-body-secondary">{{ log.timestamp.strftime('%H:%M:%S') }}</div>
                        </td>
                        <td class="py-3">
                            {% if log.user %}
                                <div class="d-flex align-items-center">
                                    <div class="avatar-circle me-2 flex-shrink-0" style="width: 32px; height: 32px; font-size: 0.8rem; line-height: 32px;">
                                        {{ log.user.username[0] | upper }}
                                    </div>
                                    <div>
                                        <div class="fw-medium text-body-emphasis">{{ log.user.username }}</div>
                                        {% if log.ip_address %}
                                            <div class="small text-body-secondary" style="font-size: 0.75rem;">IP: {{ log.ip_address }}</div>
                                        {% endif %}
                                    </div>
                                </div>
                            {% else %}
                                <span class="text-muted fst-italic">System</span>
                            {% endif %}
                        </td>
                        <td class="py-3">
                            <div class="d-flex align-items-center gap-2">
                                {% if log.action == 'CREATE' %}
                                    <span class="badge bg-success-subtle text-success border border-success-subtle rounded-pill px-2 py-1"><i class="bi bi-plus-circle me-1"></i>CREATE</span>
                                {% elif log.action == 'UPDATE' %}
                                    <span class="badge bg-primary-subtle text-primary border border-primary-subtle rounded-pill px-2 py-1"><i class="bi bi-pencil me-1"></i>UPDATE</span>
                                {% elif log.action == 'DELETE' %}
                                    <span class="badge bg-danger-subtle text-danger border border-danger-subtle rounded-pill px-2 py-1"><i class="bi bi-trash me-1"></i>DELETE</span>
                                {% elif log.action == 'LOGIN' or log.action == 'LOGOUT' %}
                                    <span class="badge bg-info-subtle text-info border border-info-subtle rounded-pill px-2 py-1"><i class="bi bi-person-check me-1"></i>{{ log.action }}</span>
                                {% elif log.action == 'SECURITY' %}
                                    <span class="badge bg-warning-subtle text-warning border border-warning-subtle rounded-pill px-2 py-1"><i class="bi bi-shield-exclamation me-1"></i>SECURITY</span>
                                {% else %}
                                    <span class="badge bg-secondary-subtle text-secondary border border-secondary-subtle rounded-pill px-2 py-1">{{ log.action }}</span>
                                {% endif %}
                                <span class="small fw-bold text-body-secondary">{{ log.entity_type }}</span>
                            </div>
                        </td>
                        <td class="pe-4 py-3">
                            <span class="text-body-emphasis">{{ log.details }}</span>
                        </td>
                    </tr>
                    {% else %}
                    <tr>
                        <td colspan="4" class="text-center py-5 text-muted">
                            <i class="bi bi-inbox fs-1 d-block mb-3 opacity-50"></i>
                            No logs found matching your criteria.
                        </td>
                    </tr>
                    {% endfor %}
                </tbody>
            </table>
        </div>
    </div>

    <!-- Pagination -->
    {% if pagination.pages > 1 %}
    <nav class="mt-5 d-flex justify-content-center" aria-label="Page navigation">
        <ul class="pagination pagination-custom shadow-sm">

            <li class="page-item {{ 'disabled' if pagination.page == 1 }}">
                <a class="page-link" href="{{ url_for('logs.view_logs', page=1, q=search_query, action=current_action, entity=current_entity, user=current_user_filter) }}">
                    <i class="bi bi-chevron-double-left"></i>
                </a>
            </li>

            {% for p in pagination.iter_pages(left_edge=1, left_current=3, right_current=3, right_edge=1) %}
                {% if p %}
                    {% if p == pagination.page %}
                        <li class="page-item active"><span class="page-link">{{ p }}</span></li>
                    {% else %}
                        <li class="page-item">
                            <a class="page-link" href="{{ url_for('logs.view_logs', page=p, q=search_query, action=current_action, entity=current_entity, user=current_user_filter) }}">{{ p }}</a>
                        </li>
                    {% endif %}
                {% else %}
                    <li class="page-item disabled"><span class="page-link border-0 text-muted bg-transparent">...</span></li>
                {% endif %}
            {% endfor %}

            <li class="page-item {{ 'disabled' if pagination.page == pagination.pages }}">
                <a class="page-link" href="{{ url_for('logs.view_logs', page=pagination.pages, q=search_query, action=current_action, entity=current_entity, user=current_user_filter) }}">
                    <i class="bi bi-chevron-double-right"></i>
                </a>
            </li>

        </ul>
    </nav>
    {% endif %}
</div>
{% endblock %}
</file>

