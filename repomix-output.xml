            <div class="row align-items-center">
                <div class="col-md-5 mb-4 mb-md-0 text-center">
                    <p class="text-muted small fw-bold text-uppercase mb-2">Current Default Image</p>
                    <div class="border border-secondary-subtle rounded-4 bg-body-secondary d-flex align-items-center justify-content-center mx-auto shadow-sm" style="height: 200px; width: 100%; max-width: 300px; overflow: hidden;">
                        <img src="{{ url_for('static', filename='uploads/default.png') }}?v={{ default_timestamp }}" alt="Default" class="w-100 h-100 object-fit-contain">
                    </div>
                </div>
                <div class="col-md-7">
                    <form action="{{ url_for('settings.update_default_image') }}" method="POST" enctype="multipart/form-data">
