<file path="tab_view/templates/devices/device-schedule.html">
{% extends 'layout/base.html' %}

{% block title %}Device Schedule{% endblock %}

{% block content %}
<div class="container">
    <div class="alert alert-info text-center shadow-sm py-3 mb-4 border border-info rounded-4">
        <i class="bi bi-info-circle me-2"></i>
        <strong>Device Schedule:</strong> {{ device.name }}
        <br>
        <span class="text-muted">Changes in this schedule override the device's default media.</span>
    </div>
</div>

<div class="container">
    <div class="row justify-content-center g-4">
        <div class="col-12">
            <div class="card border-0 shadow-sm rounded-4 bg-body-tertiary h-100">
                <div class="card-body p-2 p-md-4">
                    <div id="calendar" class="modern-calendar"></div>
                </div>
            </div>
        </div>
    </div>
</div>

<!-- Main Event Modal -->
<div class="modal fade" id="eventModal" tabindex="-1" data-bs-backdrop="static" aria-hidden="true">
    <div class="modal-dialog modal-lg">
        <div class="modal-content border-0 shadow-lg">
            <div class="modal-header border-bottom-0 pb-0">
                <h5 class="modal-title fs-4" id="eventModalLabel">New Event</h5>
                <button type="button" class="btn-close" data-bs-dismiss="modal"></button>
            </div>
            <div class="modal-body py-4">
                <form id="eventForm">

                    <div id="eventFormError" class="alert alert-danger d-none shadow-sm rounded-3 mb-4" role="alert">
                        <i class="bi bi-exclamation-triangle-fill me-2"></i><span id="eventFormErrorText"></span>
                    </div>

                    <div class="mb-4">
                        <label for="eventTitle" class="form-label fw-bold">Event Name:</label>
                        <input type="text" class="form-control form-control-lg shadow-sm rounded-3" id="eventTitle" required maxlength="50">
                        <div class="form-text text-muted mt-1">Maximum 50 characters.</div>
                    </div>

                    <div class="row">
                        <div class="col-md-6 mb-4">
                            <label for="eventStart" class="form-label fw-bold">Event Start:</label>
                            <input type="text" class="form-control form-control-lg shadow-sm rounded-3" id="eventStart" required>
                        </div>

                        <div class="col-md-6 mb-4">
                            <label for="eventEnd" class="form-label fw-bold">Event End:</label>
                            <input type="text" class="form-control form-control-lg shadow-sm rounded-3" id="eventEnd" required>
                        </div>
                    </div>

                    <div class="mb-4">
                        <label for="eventColor" class="form-label fw-bold">Event Color:</label>
                        <div class="d-flex gap-2 align-items-center">
                            <input type="color" class="form-control form-control-color shadow-sm rounded-3" id="eventColor" value="#3788d8" title="Choose color">
                            <div class="color-presets d-flex gap-2">
                                <button type="button" class="btn btn-sm color-preset shadow-sm" data-color="#3788d8" style="background-color: #3788d8; width: 32px; height: 32px; border-radius: 50%;" title="Blue"></button>
                                <button type="button" class="btn btn-sm color-preset shadow-sm" data-color="#28a745" style="background-color: #28a745; width: 32px; height: 32px; border-radius: 50%;" title="Green"></button>
                                <button type="button" class="btn btn-sm color-preset shadow-sm" data-color="#dc3545" style="background-color: #dc3545; width: 32px; height: 32px; border-radius: 50%;" title="Red"></button>
                                <button type="button" class="btn btn-sm color-preset shadow-sm" data-color="#ffc107" style="background-color: #ffc107; width: 32px; height: 32px; border-radius: 50%;" title="Yellow"></button>
                                <button type="button" class="btn btn-sm color-preset shadow-sm" data-color="#6f42c1" style="background-color: #6f42c1; width: 32px; height: 32px; border-radius: 50%;" title="Purple"></button>
                                <button type="button" class="btn btn-sm color-preset shadow-sm" data-color="#fd7e14" style="background-color: #fd7e14; width: 32px; height: 32px; border-radius: 50%;" title="Orange"></button>
                            </div>
                        </div>
                        <small class="text-muted mt-1 d-block">Click a preset color or choose your own.</small>
                    </div>

                    <div class="mb-4 mt-3">
                        <div class="form-check form-switch mb-2">
                            <input class="form-check-input" type="checkbox" role="switch" id="eventShowClock" style="cursor: pointer; transform: scale(1.3); margin-left: -2em; margin-right: 1em;">
                            <label class="form-check-label fw-bold" for="eventShowClock" style="cursor: pointer;">Show Clock on Screen</label>
                        </div>
                        <div class="alert alert-secondary py-2 small mb-0 border-secondary-subtle shadow-sm rounded-3">
                            Displays the current date and time during this specific event. Overrides the default device settings.
                        </div>
                    </div>

                    <div class="mb-4 mt-3">
                        <div class="form-check form-switch mb-2">
                            <input class="form-check-input" type="checkbox" role="switch" id="eventShowWeather" style="cursor: pointer; transform: scale(1.3); margin-left: -2em; margin-right: 1em;">
                            <label class="form-check-label fw-bold" for="eventShowWeather" style="cursor: pointer;">Show Weather Widget</label>
                        </div>
                        <div class="alert alert-secondary py-2 small mb-0 border-secondary-subtle shadow-sm rounded-3">
                            Displays a 3-day weather forecast sidebar for Poznań during this specific event. Overrides the default device settings.
                        </div>
                    </div>

                    <hr class="my-4 border-secondary opacity-25">

                    <div class="mb-4 mt-3">
                        <div class="form-check form-switch mb-2">
                            <input class="form-check-input" type="checkbox" role="switch" id="eventTextOnly" style="cursor: pointer; transform: scale(1.3); margin-left: -2em; margin-right: 1em;">
                            <label class="form-check-label fw-bold" for="eventTextOnly" style="cursor: pointer;">Display Event Name text only</label>
                        </div>
                        <div class="alert alert-secondary py-2 small mb-0 border-secondary-subtle shadow-sm rounded-3">
                            Hides the media playlist and displays only the Event Name on a plain background.
                        </div>
                    </div>

                    <div id="mediaSection" class="mb-4">
                        <div class="d-flex justify-content-between align-items-center mb-3">
                            <label class="form-label fw-bold mb-0">Media Playlist:</label>
                            <button type="button" class="btn btn-success btn-sm px-4 shadow-sm rounded-pill" id="addMediaToPlaylist">
                                <i class="bi bi-plus-circle me-1"></i> Select media
                            </button>
                        </div>

                        <div id="playlistContainer" class="border rounded-3 p-3 bg-body shadow-sm" style="min-height: 120px;">
                            <p class="text-muted text-center my-4" id="emptyPlaylistMsg">
                                <i class="bi bi-info-circle d-block fs-3 mb-2"></i>
                                Click "Select media" to create a playlist
                            </p>
                        </div>
                        <small class="text-muted mt-2 d-block">Drag items to change their order.</small>

                        <div class="alert alert-info border-start border-info rounded-3 shadow-sm mt-3 mb-0" role="alert">
                            <small>
                                <i class="bi bi-info-circle me-1"></i> Media will be displayed in sequence in a loop for the entire schedule duration.
                                Images are shown for the specified time, videos play until the end.
                            </small>
                        </div>
                    </div>

                </form>
            </div>
            <div class="modal-footer bg-body border-top border-secondary-subtle d-flex justify-content-between pt-3 pb-3">
                <button type="button" class="btn btn-secondary btn-lg px-5 shadow-sm rounded-pill" data-bs-dismiss="modal">Cancel</button>
                <div class="d-flex gap-2">
                    <button type="button" class="btn btn-outline-danger btn-lg px-5 shadow-sm rounded-pill" id="deleteEventBtn" style="display:none;">Delete</button>
                    <button type="button" class="btn btn-primary btn-lg px-5 shadow-sm rounded-pill" id="saveEventBtn">Save</button>
                </div>
            </div>
        </div>
    </div>
</div>

<!-- Group vs Instance Delete Modal -->
<div class="modal fade" id="deleteOptionsModal" tabindex="-1" aria-hidden="true" style="z-index: 1060;">
    <div class="modal-dialog modal-dialog-centered">
        <div class="modal-content border-0 shadow-lg">
            <div class="modal-header border-bottom-0 pb-0 bg-danger text-white">
                <h5 class="modal-title fs-4"><i class="bi bi-exclamation-triangle-fill me-2"></i>Delete Event</h5>
                <button type="button" class="btn-close btn-close-white" data-bs-dismiss="modal"></button>
            </div>
            <div class="modal-body py-4">
                <p class="fs-5 mb-4">This event is assigned to multiple devices. How would you like to delete it?</p>
                <div class="d-grid gap-3">
                    <button type="button" class="btn btn-outline-primary btn-lg text-start shadow-sm rounded-3 py-3" id="deleteInstanceBtn">
                        <i class="bi bi-display me-2 fs-4 align-middle"></i>
                        <span class="fw-bold align-middle">Remove from this device only</span>
                        <small class="d-block text-muted mt-1 ms-4 ps-2">The event will continue to display on other devices.</small>
                    </button>
                    <button type="button" class="btn btn-outline-danger btn-lg text-start shadow-sm rounded-3 py-3" id="deleteGroupBtn">
                        <i class="bi bi-trash-fill me-2 fs-4 align-middle"></i>
                        <span class="fw-bold align-middle">Delete from ALL devices</span>
                        <small class="d-block text-danger mt-1 ms-4 ps-2">This action is permanent and cannot be undone.</small>
                    </button>
                </div>
            </div>
        </div>
    </div>
</div>

<!-- Media Picker Modal -->
<div class="modal fade" id="playlistMediaPickerModal" tabindex="-1" aria-hidden="true">
    <div class="modal-dialog modal-xl">
        <div class="modal-content border-0 shadow-lg">
            <div class="modal-header border-bottom-0 pb-0">
                <h5 class="modal-title fs-4">Select Media for Playlist</h5>
                <button type="button" class="btn-close" data-bs-dismiss="modal"></button>
            </div>
            <div class="modal-body py-4" style="max-height: 70vh; overflow-y: auto;">

                <div class="mb-4 d-flex flex-wrap gap-2" id="mediaTagFilters">
                    <input type="checkbox" class="btn-check tag-filter-checkbox" id="tag-all" data-filter="all" autocomplete="off" checked>
                    <label class="btn btn-outline-primary btn-sm rounded-pill shadow-sm" for="tag-all">All</label>

                    {% for tag in tags %}
                        <input type="checkbox" class="btn-check tag-filter-checkbox" id="tag-{{ tag.id }}" data-filter="{{ tag.id }}" autocomplete="off">
                        <label class="btn btn-outline-primary btn-sm rounded-pill shadow-sm" for="tag-{{ tag.id }}">{{ tag.name }}</label>
                    {% endfor %}
                </div>

                <div class="row g-3">
                    {% for media in media_list %}
                    <div class="col-6 col-md-4 col-lg-3 media-filter-item" data-tag-id="{{ media.tag_id }}">
                        <div class="card playlist-media-item h-100 shadow-sm border-secondary-subtle"
                             data-media-id="{{ media.id }}"
                             data-media-filename="{{ media.filename }}"
                             data-media-type="{{ media.media_type }}"
                             style="cursor: pointer;">
                            {% if media.media_type == 'image' %}
                                <img src="{{ url_for('static', filename='uploads/' + media.filename) }}"
                                     class="card-img-top object-fit-cover"
                                     style="height: 150px;"
                                     alt="{{ media.filename }}"
                                     loading="lazy">
                            {% elif media.media_type == 'video' %}
                                <video class="card-img-top object-fit-cover" style="height: 150px;" preload="metadata">
                                    <source src="{{ url_for('static', filename='uploads/' + media.filename) }}" type="video/mp4">
                                </video>
                            {% endif %}
                            <div class="card-body p-2">
                                {% if media.media_type == 'video' %}
                                <span class="badge bg-primary mb-1">
                                    <i class="bi bi-play-fill"></i> Video
                                </span>
                                {% else %}
                                <span class="badge bg-success mb-1">
                                    <i class="bi bi-image"></i> Image
                                </span>
                                {% endif %}
                                <small class="d-block text-truncate fw-medium" title="{{ media.filename }}">
                                    {{ media.filename }}
                                </small>
                            </div>
                        </div>
                    </div>
                    {% endfor %}
                </div>
            </div>
            <div class="modal-footer bg-body border-top border-secondary-subtle d-flex justify-content-end pt-3 pb-3">
                <button type="button" class="btn btn-secondary btn-lg px-5 shadow-sm rounded-pill" data-bs-dismiss="modal">Close</button>
            </div>
        </div>
    </div>
</div>
{% endblock %}

{% block scripts %}
<script>
    window.currentDeviceId = {{ device.id }};
    window.mediaList = {{ media_list|tojson }};
    window.isAdmin = {{ 'true' if current_user.is_admin else 'false' }};
</script>
<script src="{{ url_for('static', filename='js/device-schedule.js') }}"></script>
{% endblock %}
</file>

<file path="tab_view/templates/devices/devices.html">
{% extends 'layout/base.html' %}

{% block title %}Device Management Center{% endblock %}

{% block content %}
    {% for device in devices %}
        <div class="modal fade" id="deleteDeviceModal{{ device.id }}" tabindex="-1" aria-hidden="true" data-bs-backdrop="static" data-bs-keyboard="false">
            <div class="modal-dialog modal-dialog-centered">
                <div class="modal-content border-0 shadow-lg">
                    <div class="modal-header border-bottom-0 pb-0">
                        <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
                    </div>
                    <div class="modal-body text-center py-4">
                        <i class="bi bi-exclamation-triangle-fill text-danger mb-3 d-block" style="font-size: 3rem;"></i>
                        <h4 class="mb-3">Delete Device?</h4>
                        <p class="text-muted mb-0">Are you sure you want to delete <strong class="text-body-emphasis">{{ device.name }}</strong>?<br>This action cannot be undone.</p>
                    </div>
                    <div class="modal-footer bg-body border-top border-secondary-subtle d-flex justify-content-between pt-3 pb-3">
                        <button type="button" class="btn btn-secondary btn-lg px-5 shadow-sm rounded-pill" data-bs-dismiss="modal">Cancel</button>
                        <form action="{{ url_for('devices.delete_device', device_id=device.id) }}" method="POST" class="m-0">
                            {{ form.hidden_tag() }}
                            <button type="submit" class="btn btn-danger btn-lg px-5 shadow-sm rounded-pill">Delete</button>
                        </form>
                    </div>
                </div>
            </div>
        </div>
    {% endfor %}

    <div class="container mt-5">
        <div class="row mb-5 align-items-center">
            <div class="col-md-6 mb-3 mb-md-0">
                <div class="dropdown">
                    <button class="btn btn-outline-secondary dropdown-toggle shadow-sm px-4 rounded-pill bg-body text-body" type="button" data-bs-toggle="dropdown" aria-expanded="false">
                        <i class="bi bi-sort-alpha-down me-2 text-primary"></i> Sort: <strong>{{ 'Z-A' if current_sort == 'desc' else 'A-Z' }}</strong>
                    </button>
                    <ul class="dropdown-menu shadow-sm border-0">
                        <li>
                            <a class="dropdown-item {% if current_sort == 'asc' %}active{% endif %}" href="{{ url_for('devices.get_all_devices', sort='asc', page=1) }}">
                                Name (A-Z)
                            </a>
                        </li>
                        <li>
                            <a class="dropdown-item {% if current_sort == 'desc' %}active{% endif %}" href="{{ url_for('devices.get_all_devices', sort='desc', page=1) }}">
                                Name (Z-A)
                            </a>
                        </li>
                    </ul>
                </div>
            </div>
            <div class="col-md-6 text-md-end">
                {% if current_user.is_admin %}
                    <a class="btn btn-primary btn-lg px-5 shadow-sm rounded-pill" role="button" href="{{ url_for('devices.create_device') }}">
                        <i class="bi bi-plus-circle-fill me-2"></i>Create New Device
                    </a>
                {% else %}
                    <a class="btn btn-primary btn-lg px-5 shadow-sm rounded-pill disabled" role="button">
                        <i class="bi bi-plus-circle-fill me-2"></i>Create New Device
                    </a>
                {% endif %}
            </div>
        </div>

        <div class="row g-4">
            {% for device in devices %}
                <div class="col-12 col-sm-6 col-lg-4 col-xl-3">
                    <div class="card h-100 border-0 shadow-sm rounded-4 bg-body-tertiary position-relative">
                        <div class="position-relative overflow-hidden rounded-top-4 bg-dark d-flex align-items-center justify-content-center" style="height: 200px;">

                            {% if device.media %}
                                {% if device.media.media_type == 'image' %}
                                    <img src="{{ url_for('static', filename='uploads/' ~ device.media.filename) }}" alt="{{ device.name }}" class="w-100 h-100 object-fit-cover opacity-hover">
                                {% elif device.media.media_type == 'video' %}
                                    <video class="w-100 h-100 object-fit-cover opacity-hover hover-video" muted loop playsinline preload="metadata">
                                        <source src="{{ url_for('static', filename='uploads/' ~ device.media.filename) }}" type="video/mp4">
                                        Your browser does not support video playback.
                                    </video>
                                {% else %}
                                    <img src="{{ url_for('static', filename='img/default.jpg') }}" alt="Default Media" class="w-100 h-100 object-fit-cover opacity-hover">
                                {% endif %}
                            {% else %}
                                <img src="{{ url_for('static', filename='img/default.jpg') }}" alt="Default Image" class="w-100 h-100 object-fit-cover opacity-hover">
                            {% endif %}

                            <div class="card-overlay position-absolute top-0 start-0 w-100 h-100 d-flex flex-column justify-content-between p-3">
                                <div class="d-flex justify-content-between align-items-start">
                                    <div class="d-flex gap-1">
                                        <span class="badge rounded-pill bg-dark bg-opacity-50 border border-light border-opacity-25 d-flex align-items-center">
                                            <i class="bi bi-display me-1"></i>DEVICE
                                        </span>
                                    </div>

                                    <div class="dropdown position-relative z-3">
                                        <button class="btn btn-light btn-sm rounded-circle shadow-sm p-0 d-flex align-items-center justify-content-center" style="width: 32px; height: 32px;" type="button" data-bs-toggle="dropdown" aria-expanded="false">
                                            <i class="bi bi-three-dots-vertical"></i>
                                        </button>
                                        <ul class="dropdown-menu dropdown-menu-end shadow-lg border-0">
                                            <li>
                                                <a class="dropdown-item py-2" href="{{ url_for('devices.device_schedule', device_id=device.id) }}">
                                                    <i class="bi bi-calendar-event me-2"></i>Schedule
                                                </a>
                                            </li>
                                            <li>
                                                <a class="dropdown-item py-2" href="{{ url_for('devices.show_device', device_url=device.device_url) }}" target="_blank">
                                                    <i class="bi bi-box-arrow-up-right me-2"></i>Open View
                                                </a>
                                            </li>
                                            {% if current_user.is_admin %}
                                                <li><hr class="dropdown-divider"></li>
                                                <li>
                                                    <a class="dropdown-item py-2" href="{{ url_for('devices.update_device', device_id=device.id) }}">
                                                        <i class="bi bi-gear me-2"></i>Update
                                                    </a>
                                                </li>
                                                <li>
                                                    <button type="button" class="dropdown-item py-2 text-danger" data-bs-toggle="modal" data-bs-target="#deleteDeviceModal{{ device.id }}" data-device-name="{{ device.name }}" data-device-id="{{ device.id }}">
                                                        <i class="bi bi-trash me-2"></i>Delete
                                                    </button>
                                                </li>
                                            {% else %}
                                                <li><hr class="dropdown-divider"></li>
                                                <li>
                                                    <button type="button" class="dropdown-item py-2 disabled" data-bs-toggle="modal" data-device-name="{{ device.name }}" data-device-id="{{ device.id }}">
                                                        <i class="bi bi-trash me-2"></i>Delete
                                                    </button>
                                                </li>
                                            {% endif %}
                                        </ul>
                                    </div>
                                </div>
                            </div>
                        </div>

                        <div class="card-body p-3">
                            <h6 class="card-title text-truncate mb-1 fw-bold" title="{{ device.name }}">
                                {% if current_user.is_admin %}
                                    <a href="{{ url_for('devices.update_device', device_id=device.id) }}" class="stretched-link text-decoration-none text-body">{{ device.name }}</a>
                                {% else %}
                                    <span class="text-body">{{ device.name }}</span>
                                {% endif %}
                            </h6>
                            <p class="card-text small text-muted mb-0 text-truncate position-relative z-3">
                                <i class="bi bi-link-45deg me-1"></i>
                                <a href="{{ url_for('devices.show_device', device_url=device.device_url) }}" class="text-decoration-none text-muted" data-bs-toggle="tooltip" data-bs-placement="bottom" data-bs-title="http://10.10.4.201/devices/{{ device.device_url }}" data-bs-custom-class="custom-tooltip">/devices/{{ device.device_url }}</a>
                            </p>
                        </div>
                    </div>
                </div>
            {% endfor %}
        </div>

        <nav class="mt-5 d-flex justify-content-center" aria-label="Page navigation">
    <ul class="pagination pagination-custom shadow-sm mx-auto">

        <li class="page-item {{ 'disabled' if pagination.page == 1 }}">
            <a class="page-link" href="{{ url_for('devices.get_all_devices', page=1, sort=current_sort) }}" aria-label="First">
                <i class="bi bi-chevron-double-left"></i>
            </a>
        </li>

        {% for p in pagination.iter_pages(left_edge=1, left_current=3, right_current=3, right_edge=1) %}
            {% if p %}
                {% if p == pagination.page %}
                    <li class="page-item active"><span class="page-link" aria-current="page">{{ p }}</span></li>
                {% else %}
                    <li class="page-item">
                        <a class="page-link" href="{{ url_for('devices.get_all_devices', page=p, sort=current_sort) }}">{{ p }}</a>
                    </li>
                {% endif %}
            {% else %}
                <li class="page-item disabled"><span class="page-link border-0 text-muted bg-transparent">...</span></li>
            {% endif %}
        {% endfor %}

        <li class="page-item {{ 'disabled' if pagination.page == pagination.pages }}">
            <a class="page-link" href="{{ url_for('devices.get_all_devices', page=pagination.pages, sort=current_sort) }}" aria-label="Last">
                <i class="bi bi-chevron-double-right"></i>
            </a>
        </li>

    </ul>
</nav>
    </div>
{% endblock %}

{% block scripts %}
<script src="{{ url_for('static', filename='js/hover-video.js') }}"></script>
{% endblock %}
</file>

