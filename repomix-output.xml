                <div>
                    <h3 class="fs-3 fw-bold mb-0">System Backup & Restore</h3>
                    <p class="text-muted small mb-0">Export data to a safe ZIP file or restore from a previous backup.</p>
                </div>
            </div>

            <div class="row g-5">
                <div class="col-12 col-lg-6 border-end-lg border-secondary-subtle">
                    <h5 class="fw-bold mb-4"><i class="bi bi-cloud-download me-2"></i>Export Data</h5>
                    <form action="{{ url_for('settings.export_data') }}" method="POST">
                        {{ export_form.hidden_tag() }}

