                            <a href="{{ url_for('media.get_all_media') }}" class="btn btn-secondary btn-lg px-5 shadow-sm rounded-pill">Cancel</a>
                            {{ form.submit(class="btn btn-primary btn-lg px-5 shadow-sm rounded-pill") }}
                        </div>
                    </form>
                </div>
            </div>
