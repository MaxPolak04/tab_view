      # Prevents committing directly to the protected branch locally
      - id: no-commit-to-branch
        args: ['--branch', 'main']
      # Prevents unnecessary diffs caused by invisible characters
      - id: trailing-whitespace
      # Ensures POSIX standard compliance for file endings
      - id: end-of-file-fixer
      # Fails early locally before CI catches malformed configuration
