            <p class="text-body-secondary">Upload and manage your images and videos</p>
        </div>
        <a class="btn btn-primary btn-lg px-5 shadow-sm rounded-pill" href="{{ url_for('media.new_media') }}">
            <i class="bi bi-cloud-arrow-up-fill me-2"></i>Add New Media
        </a>
    </div>

    <div class="card border-0 shadow-sm rounded-4 mb-4 bg-body-tertiary">
        <div class="card-body p-3">
            <div class="row align-items-center">
                <div class="col-md-8 d-flex gap-3">

                    <div class="dropdown">
                        <button class="btn btn-outline-secondary border dropdown-toggle shadow-sm rounded-pill bg-body text-body"
                            type="button" data-bs-toggle="dropdown" data-bs-auto-close="outside">
                            <i class="bi bi-tags-fill me-2 text-primary"></i>
                            Tags: <strong>{{ active_tag_names }}</strong>
                        </button>
                        <div class="dropdown-menu shadow-sm border-0 p-3" style="min-width: 260px;">
                            <form action="{{ url_for('media.get_all_media') }}" method="GET">
                                <input type="hidden" name="sort" value="{{ current_sort }}">

                                <div class="mb-3 overflow-auto" style="max-height: 250px;">

                                    {% set ns = namespace(custom_selected=0, system_selected=0, total_custom=0) %}
                                    {% for t in tags %}
                                        {% if not t.is_system %}
                                            {% set ns.total_custom = ns.total_custom + 1 %}
                                        {% endif %}
                                        {% if t.id in current_tags %}
                                            {% if t.is_system %}
                                                {% set ns.system_selected = ns.system_selected + 1 %}
                                            {% else %}
                                                {% set ns.custom_selected = ns.custom_selected + 1 %}
                                            {% endif %}
                                        {% endif %}
                                    {% endfor %}

                                    <div class="form-check mb-2 border-bottom pb-2">
                                        <input class="form-check-input" type="checkbox" id="tagCheckAll"
                                            {% if not current_tags %}checked{% endif %}
                                            onclick="document.querySelectorAll('input[name=tag]').forEach(el => el.checked = false); document.getElementById('tagCheckCustom').checked = false; this.checked = true;">
                                        <label class="form-check-label fw-bold" for="tagCheckAll">
                                            All Tags
                                        </label>
                                    </div>

                                    <div class="form-check mb-2 border-bottom pb-2">
                                        <input class="form-check-input" type="checkbox" id="tagCheckCustom"
                                            {% if current_tags and ns.custom_selected == ns.total_custom and ns.system_selected == 0 %}checked{% endif %}
                                            onclick="
                                                const isChecked = this.checked;
